<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="customer_account_navigation">
            <block class="Magento\Customer\Block\Account\SortLinkInterface"
                   ifconfig="techyouknow_social_network/general/enable"
                   name="customer-account-navigation-social-connections">
                <arguments>
                    <argument name="label" xsi:type="string" translate="true">Social Login</argument>
                    <argument name="path" xsi:type="string">customer/sociallogin/index</argument>
                    <argument name="sortOrder" xsi:type="number">209</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
