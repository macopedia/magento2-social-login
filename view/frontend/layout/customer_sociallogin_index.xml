<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="2columns-left" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <title>Social Login Connections</title>
        <css src="Techyouknow_SocialLogin::css/styles.css"/>
    </head>
    <update handle="customer_account"/>
    <body>
        <referenceBlock name="page.main.title">
            <action method="setPageTitle">
                <argument translate="true" name="title" xsi:type="string">Social Login Connections</argument>
            </action>
        </referenceBlock>
        <referenceContainer name="content">
            <block class="Techyouknow\SocialLogin\Block\Account\SocialConnections"
                   name="techyouknow_social_connections"
                   template="Techyouknow_SocialLogin::account/social_connections.phtml"
                   cacheable="false"/>
        </referenceContainer>
    </body>
</page>
