                        <div class="control">
                            <input type="email"
                                   id="email"
                                   value="<?= $email ?>"
                                   class="input-text"
                                   readonly
                                   disabled/>
                        </div>
                    </div>
                </fieldset>

                <fieldset class="fieldset create account">
                    <legend class="legend"><span><?= $block->escapeHtml(__('Password')) ?></span></legend>

                    <div class="field password required">
